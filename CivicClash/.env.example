# ─────────────────────────────────────────────────────────────
# CivicClash — Environment Variables Template
# ─────────────────────────────────────────────────────────────

# Server Port (Railway, Render, Heroku and Docker set this automatically)
PORT=8788

# Node Environment
NODE_ENV=production

# Optional: Set only if the frontend is hosted on a separate domain/origin from the Socket.IO backend
# (e.g. Vercel frontend pointing to Railway backend)
# VITE_SERVER_URL=https://your-civicclash-backend.up.railway.app

